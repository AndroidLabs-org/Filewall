# Copy to keystore.properties (git-ignored) and fill in with the real values.
# The keystore itself is never committed - keep it, and a backup of it, outside the repository.
# In CI the same four values are read from RELEASE_STOREFILE, RELEASE_STOREPASSWORD,
# RELEASE_KEYALIAS and RELEASE_KEYPASSWORD.
storeFile=/path/to/your-release.jks
storePassword=
keyAlias=
keyPassword=
